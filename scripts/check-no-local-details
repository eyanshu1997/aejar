#!/usr/bin/env bash
#
# check-no-local-details: refuse to let one deployment's details into this
# public repo. Deployment values belong in deploy/aejar.env (gitignored) or in
# the data directory on the server, never in tracked files or commit messages.
#
#   scripts/check-no-local-details            # tracked + staged files
#   scripts/check-no-local-details A..B       # also commit messages in a range
set -uo pipefail
cd "$(dirname "$0")/.." || exit 2

patterns=(
    # credentials
    # (a value starting with "fake" is a test placeholder; paths are not values)
    '(?i)(api[_-]?key|secret|token|password)[[:space:]]*[:=][[:space:]]*["'"'"']?(?!fake|sk-ant-fake)[A-Za-z0-9+_-]{24,}'
    '\bsk-ant-(?!fake)[A-Za-z0-9-]{10,}'
    # private network addresses
    '\b(10\.[0-9]{1,3}|192\.168|172\.(1[6-9]|2[0-9]|3[01])|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7]))\.[0-9]{1,3}\.[0-9]{1,3}\b'
    # emails outside reserved example domains
    '(?i)[a-z0-9._%+-]+@(?!example\.(com|org|net)\b)(?![a-z0-9.-]*\.example\b)[a-z0-9.-]+\.[a-z]{2,}'
    # a real Google OAuth client id
    '\b[0-9]{12}-[a-z0-9]{32}\.apps\.googleusercontent\.com'
    # personal home directories (the aejar service user and the in-container agent are fine)
    '/home/(?!aejar\b|agent\b)[a-z0-9_-]+'
)

files=$(git ls-files --cached -- . ':!:coherence' ':!:gen/**' ':!:**/package-lock.json')
status=0
for p in "${patterns[@]}"; do
    if hits=$(echo "$files" | xargs -r grep -nP -- "$p" 2>/dev/null); then
        echo "$hits"
        status=1
    fi
done
if [[ -n "${1:-}" ]] && msgs=$(git log --format='%H %B' "$1" | grep -nP -- "$(IFS='|'; echo "${patterns[*]}")"); then
    echo "commit messages:"; echo "$msgs"; status=1
fi
[[ $status -eq 0 ]] && echo "ok: no deployment details found"
exit $status
