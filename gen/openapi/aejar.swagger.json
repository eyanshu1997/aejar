    "v1SendToTaskResponse": {
      "type": "object",
      "properties": {
        "eventId": {
          "type": "string"
        },
        "delivered": {
          "type": "boolean",
          "description": "True when delivered now; false when queued for the next session start."
        }
      }
    },
    "v1Task": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "prompt": {
          "type": "string"
        },
        "class": {
          "$ref": "#/definitions/v1TaskClass"
        },
        "state": {
          "$ref": "#/definitions/v1TaskState"
        },
        "userBump": {
          "type": "integer",
          "format": "int32",
          "description": "Owner-set adjustment added to the computed score."
        },
        "score": {
          "type": "integer",
          "format": "int32",
          "description": "Computed priority score at read time."
        },
        "waitReason": {
          "type": "string",
          "description": "Why the task is waiting, when state is WAITING."
        },
        "profile": {
          "type": "string",
          "description": "Session profile: plan, research, mail, action, project."
        },
        "claudeSessionId": {
          "type": "string",
          "description": "Claude Code session id, used for --resume."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "docFolder": {
          "type": "string",
          "description": "Coherence folder holding this task's docs."
        }
      }
    },
    "v1TaskClass": {
      "type": "string",
      "enum": [
        "TASK_CLASS_UNSPECIFIED",
        "TASK_CLASS_P0",
        "TASK_CLASS_P1",
        "TASK_CLASS_P2",
        "TASK_CLASS_P3"
      ],
      "default": "TASK_CLASS_UNSPECIFIED",
      "description": "TaskClass sets a task's base priority. See plan.html §5.\n\n - TASK_CLASS_P0: Interactive, from the owner, right now.\n - TASK_CLASS_P1: Normal.\n - TASK_CLASS_P2: Background or long-running.\n - TASK_CLASS_P3: Cron housekeeping."
    },
    "v1TaskState": {
      "type": "string",
      "enum": [
        "TASK_STATE_UNSPECIFIED",
        "TASK_STATE_QUEUED",
        "TASK_STATE_RUNNING",
        "TASK_STATE_WAITING",
        "TASK_STATE_PREEMPTED",
        "TASK_STATE_LIMIT_BLOCKED",
        "TASK_STATE_PAUSED",
        "TASK_STATE_DONE",
        "TASK_STATE_FAILED",
        "TASK_STATE_REJECTED"
      ],
      "default": "TASK_STATE_UNSPECIFIED",
      "description": " - TASK_STATE_WAITING: Blocked on something external (approval, reply, CI); holds no slot."
    },
    "v1TaskSummary": {
      "type": "object",
      "properties": {
        "task": {
          "$ref": "#/definitions/v1Task"
        },
        "recentEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1AuditEvent"
          }
        },
        "pendingApprovals": {
          "type": "array",
          "items": {
            "type": "object",
            "$ref": "#/definitions/v1Approval"
          }
        }
      }
    },
    "v1VerifyAuditResponse": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "events": {
          "type": "string",
          "format": "int64"
        },
        "brokenAtSeq": {
          "type": "string",
          "format": "int64",
          "description": "First seq that failed verification, 0 when ok."
        },
        "headHash": {
          "type": "string"
        }
      }
    }
  }
}
