# Two servers on the tunnel ports; apps are internal-only. ${AEJAR_HOST} and
# ${DOCS_HOST} are filled in from aejar.env by the nginx image's template step.
# Every request except /oauth2/* and /healthz needs a Google login, and the
# identity that reaches the apps is a Google-signed ID token, never a header
# the client controls.

map $http_upgrade $connection_upgrade { default upgrade; '' close; }

# coherence (docs)
server {
    listen 9010;
    server_name ${DOCS_HOST};
    # Behind the tunnel: keep redirects relative so the browser stays on the
    # public https host instead of nginx's internal http listener and port.
    absolute_redirect off;
    client_max_body_size 50m;
    include /etc/nginx/conf.d/aejar-auth.inc;

    location / {
        auth_request /oauth2/auth;
        error_page 401 = @signin;
        auth_request_set $id_token $upstream_http_authorization;
        auth_request_set $email $upstream_http_x_auth_request_email;
        proxy_set_header X-Id-Token $id_token;
        proxy_set_header X-Remote-User "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_pass http://coherence:8080;
    }
    location @signin { return 302 /oauth2/start?rd=https://$host$request_uri; }
}

# aejar
server {
    listen 9011;
    server_name ${AEJAR_HOST};
    # Behind the tunnel: keep redirects relative so the browser stays on the
    # public https host instead of nginx's internal http listener and port.
    absolute_redirect off;
    client_max_body_size 10m;
    include /etc/nginx/conf.d/aejar-auth.inc;

    location / {
        auth_request /oauth2/auth;
        error_page 401 = @signin;
        auth_request_set $id_token $upstream_http_authorization;
        proxy_set_header X-Id-Token $id_token;
        # Browser requests carry no bearer token of their own.
        proxy_set_header Authorization "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://aejard:9111;
    }
    location = /healthz { proxy_pass http://aejard:9111/healthz; }
    location @signin { return 302 /oauth2/start?rd=https://$host$request_uri; }
}
