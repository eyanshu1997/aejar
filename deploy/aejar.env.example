# Copy to aejar.env next to compose.yaml (aejar.env is gitignored).
# Nothing here is secret; secrets live in ${AEJAR_DATA}/secrets/ (mode 600).
AEJAR_DATA=/home/aejar/aejar-data
# Session working dirs (heaviest disk I/O). Defaults to $AEJAR_DATA/sessions;
# point it at a less-loaded disk if the system disk is busy.
#AEJAR_SESSIONS=/mnt/data/aejar/sessions
# Rootless docker socket of the aejar user: /run/user/<uid>/docker.sock
DOCKER_SOCK=/run/user/1001/docker.sock
AEJAR_HOST=aejar.example.com
DOCS_HOST=docs.example.com
OWNER_EMAILS=owner@example.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
