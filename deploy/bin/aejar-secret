#!/usr/bin/env bash
# aejar-secret: store a secret for aejar without it touching shell history,
# argv or the screen.  Usage: aejar-secret <name>      (e.g. claude_oauth_token)
#                             aejar-secret --list
set -euo pipefail
dir="$HOME/aejar-data/secrets"
mkdir -p "$dir" && chmod 700 "$dir"
if [[ "${1:-}" == "--list" ]]; then
    for f in "$dir"/*; do [[ -e "$f" ]] && printf '%s  (%s bytes)\n' "$(basename "$f")" "$(wc -c < "$f")"; done
    exit 0
fi
name="${1:?usage: aejar-secret <name> | --list}"
[[ "$name" =~ ^[a-z0-9_.-]+$ ]] || { echo "bad name" >&2; exit 1; }
# Read hidden lines until an empty line, so a token that a terminal wrapped
# across lines is captured whole. Secrets are single tokens: drop whitespace.
echo "paste the value for $name (hidden), then press Enter on an empty line:"
value=""
while IFS= read -rs line && [[ -n "$line" ]]; do value+="$line"; done
value="${value//[[:space:]]/}"
[[ -n "$value" ]] || { echo "empty, nothing saved" >&2; exit 1; }
umask 077
printf '%s\n' "$value" > "$dir/$name.tmp" && mv "$dir/$name.tmp" "$dir/$name"
echo "saved $dir/$name ($(wc -c < "$dir/$name") bytes)"
